#!/usr/bin/env python3
from __future__ import annotations

import argparse
import re
from pathlib import Path


BUILTIN_PREFIXES = ("wb-", "ks-", "orch-")


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(prog="insall-work-bundle-skills")
    parser.add_argument("--home", help="Override home directory for ~/.work-bundle")
    parser.add_argument("--dry-run", action="store_true")
    return parser.parse_args()


def repo_root() -> Path:
    return Path(__file__).resolve().parents[1]


def config_root(home: str | None) -> Path:
    return (Path(home).expanduser() if home else Path.home()) / ".work-bundle"


def parse_scalar_map(path: Path) -> dict[str, str]:
    data: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, value = line.split(":", 1)
        data[key.strip()] = value.strip().strip("'\"")
    return data


def resolve_bootstrap(home: str | None) -> tuple[Path, Path]:
    root = config_root(home)
    bootstrap = root / "bootstrap.yaml"
    if not bootstrap.is_file():
        raise FileNotFoundError(f"Missing bootstrap file: {bootstrap}")
    data = parse_scalar_map(bootstrap)
    work_bundle_root = Path(data.get("work_bundle_root", "")).expanduser()
    if not work_bundle_root.is_absolute():
        work_bundle_root = (repo_root() if not str(work_bundle_root) else work_bundle_root).resolve()
    skill_registry_raw = data.get("skill_registry", "$work_bundle_config_root/registry/skill-registry.yaml")
    skill_registry = Path(skill_registry_raw.replace("$work_bundle_config_root", str(root))).expanduser()
    return work_bundle_root.resolve(), skill_registry.resolve()


def front_matter(path: Path) -> dict[str, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        return {}
    end = text.find("\n---\n", 4)
    if end == -1:
        return {}
    data: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            data[key.strip()] = value.strip().strip("'\"")
    return data


def builtin_skill_dirs(work_bundle_root: Path) -> list[Path]:
    skills_root = work_bundle_root / "skills"
    if not skills_root.is_dir():
        return []
    return [
        path
        for path in sorted(skills_root.iterdir())
        if path.is_dir() and path.name.startswith(BUILTIN_PREFIXES) and (path / "SKILL.md").is_file()
    ]


def split_registry(text: str) -> tuple[str, list[str], str]:
    lines = text.splitlines()
    skills_index = next((i for i, line in enumerate(lines) if line.strip() == "skills:" and not line.startswith(" ")), None)
    if skills_index is None:
        prefix = text.rstrip()
        return (prefix + "\n" if prefix else "", [], "")
    prefix = "\n".join(lines[:skills_index]).rstrip()
    skills_lines = lines[skills_index + 1 :]
    suffix_start = next((i for i, line in enumerate(skills_lines) if line and not line.startswith(" ")), None)
    if suffix_start is None:
        return ((prefix + "\n") if prefix else "", skills_lines, "")
    suffix = "\n".join(skills_lines[suffix_start:]).rstrip()
    return ((prefix + "\n") if prefix else "", skills_lines[:suffix_start], (suffix + "\n") if suffix else "")


def preserved_skill_blocks(skills_lines: list[str]) -> list[str]:
    blocks: list[list[str]] = []
    current: list[str] = []
    current_name = ""
    for line in skills_lines:
        match = re.match(r"^  ([A-Za-z0-9_.-]+):\s*$", line)
        if match:
            if current and not current_name.startswith(BUILTIN_PREFIXES):
                blocks.append(current)
            current = [line]
            current_name = match.group(1)
            continue
        if current:
            current.append(line)
    if current and not current_name.startswith(BUILTIN_PREFIXES):
        blocks.append(current)
    return ["\n".join(block).rstrip() for block in blocks if block]


def skill_block(skill_dir: Path) -> str:
    metadata = front_matter(skill_dir / "SKILL.md")
    description = metadata.get("description", "").replace('"', "'")
    return "\n".join(
        [
            f"  {skill_dir.name}:",
            "    type: internal",
            f"    source: {skill_dir / 'SKILL.md'}",
            "    mode: native",
            "    priority: required",
            "    used_by: [solution-architect, backend-developer, qa-reviewer]",
            "    stages: [development-design, implementation]",
            "    allowed_outputs: [skill-execution]",
            "    validation: [registered_builtin_skill]",
            "    fallback: none",
            f'    description: "{description}"',
        ]
    )


def merge_registry(registry: Path, work_bundle_root: Path) -> tuple[bool, int]:
    current = registry.read_text(encoding="utf-8") if registry.exists() else ""
    prefix, skills_lines, suffix = split_registry(current)
    preserved = preserved_skill_blocks(skills_lines)
    builtin_blocks = [skill_block(path) for path in builtin_skill_dirs(work_bundle_root)]
    if not prefix:
        prefix = "stage_skill_hints: {}\n"
    merged_parts = [prefix.rstrip(), "skills:"]
    merged_parts.extend(preserved)
    merged_parts.extend(builtin_blocks)
    if suffix.strip():
        merged_parts.append(suffix.rstrip())
    merged = "\n".join(part for part in merged_parts if part != "") + "\n"
    changed = current != merged
    if changed:
        registry.parent.mkdir(parents=True, exist_ok=True)
        registry.write_text(merged, encoding="utf-8")
    return changed, len(builtin_blocks)


def main() -> int:
    args = parse_args()
    work_bundle_root, registry = resolve_bootstrap(args.home)
    if args.dry_run:
        count = len(builtin_skill_dirs(work_bundle_root))
        print(f"dry-run: would register {count} builtin skills in {registry}")
        return 0
    changed, count = merge_registry(registry, work_bundle_root)
    status = "updated" if changed else "skipped"
    print(f"{status}: registered {count} builtin skills in {registry}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
