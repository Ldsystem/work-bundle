              "expand"
            ],
            "properties": {
              "node_id": {
                "$ref": "#/$defs/id"
              },
              "information_value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidence_cost": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "miss_risk": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "expand": {
                "type": "boolean"
              }
            }
          }
