              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "actor": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "preconditions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "failures": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "policies": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "lifecycle": {
                "enum": [
                  "candidate",
                  "grounded",
                  "accepted",
                  "superseded"
                ]
              },
              "freshness": {
