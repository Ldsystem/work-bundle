              },
              "to_id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "enum": [
                  "contains",
                  "requires",
                  "constrains",
                  "produces",
                  "consumes",
                  "transitions",
                  "validates",
                  "conflicts_with",
                  "related_to"
