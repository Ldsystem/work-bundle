{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-v3",
  "oneOf": [
    {"$ref": "#/$defs/legacy"},
    {"$ref": "#/$defs/current"}
  ],
  "$defs": {
    "sourceId": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*-[0-9]+[A-Z]?$"},
    "taskId": {"type": "string", "pattern": "^task-[a-z0-9][a-z0-9-]*$"},
    "sourceObligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "semantic"],
        "properties": {
          "source_id": {"$ref": "#/$defs/sourceId"},
          "semantic": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "truthBasis": {
      "type": "object",
      "required": ["purpose", "as_is_evidence", "decision_authority", "expected_delta", "conflict_status"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "as_is_evidence": {"type": "array", "minItems": 1},
        "decision_authority": {"type": "array", "minItems": 1},
        "expected_delta": {"type": "array", "minItems": 1},
        "conflict_status": {"enum": ["clear", "escalate"]}
      },
      "additionalProperties": false
    },
    "processDescriptor": {
      "type": "object",
      "required": ["argv", "repository_id", "working_directory", "timeout_seconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "repository_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "working_directory": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400}
      },
      "additionalProperties": false
    },
    "validationCommon": {
      "id": {"type": "string", "minLength": 1},
      "invariant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "capability_reason": {"type": "string", "minLength": 1},
      "proves": {"type": "array"},
      "expected": {},
      "acceptable_results": {"type": "array"},
      "digest": {"type": "string"},
      "evidence_reuse": {"type": "object"}
    },
    "processValidation": {
      "type": "object",
      "required": ["id", "kind", "process"],
      "properties": {
        "kind": {"const": "process"},
        "process": {"$ref": "#/$defs/processDescriptor"},
        "id": {"type": "string", "pattern": "^VAL-[A-Z0-9][A-Z0-9-]*$"},
        "invariant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capability_reason": {"type": "string", "minLength": 1},
        "proves": {"type": "array"},
        "expected": {},
        "acceptable_results": {"type": "array"},
        "digest": {"type": "string"},
        "evidence_reuse": {"type": "object"}
      },
      "additionalProperties": false
    },
    "inspectionValidation": {
      "type": "object",
      "required": ["kind", "mechanism"],
      "properties": {
        "kind": {"const": "inspection"},
        "mechanism": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "invariant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capability_reason": {"type": "string", "minLength": 1},
        "proves": {"type": "array"},
        "expected": {},
        "acceptable_results": {"type": "array"},
        "digest": {"type": "string"},
        "evidence_reuse": {"type": "object"}
      },
      "additionalProperties": false
    },
    "externalTarget": {
      "type": "object",
      "required": ["target_id", "permitted_actions", "purpose"],
      "properties": {
        "target_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "permitted_actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["configure", "start", "readiness", "stop", "run"]}
        },
        "purpose": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "interfaces": {
      "type": "object",
      "required": ["external_targets"],
      "properties": {
        "consumes": {"type": "array"},
        "produces": {"type": "array"},
        "external_targets": {"type": "array", "items": {"$ref": "#/$defs/externalTarget"}}
      },
      "additionalProperties": false
    },
    "legacy": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "id", "plan_id", "phase_id", "name", "status", "order", "task_type", "date_created", "last_updated", "source_ids", "source_obligations", "truth_basis", "depends_on", "source_files", "target_files", "target_symbols", "interfaces", "steps", "validation", "evidence_capability", "completion_criteria", "methodology", "executor_profile", "acceptance_review", "allocated_rules", "allocated_skills", "handoff_contract"],
      "properties": {
        "artifact_type": {"const": "task"},
        "schema_version": {"const": 2},
        "id": {"$ref": "#/$defs/taskId"},
        "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
        "phase_id": {"type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "planned"},
        "order": {"type": "integer", "minimum": 1},
        "task_type": {"type": "string", "minLength": 1},
        "date_created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "last_updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceId"}, "uniqueItems": true},
        "source_obligations": {"$ref": "#/$defs/sourceObligations"},
        "truth_basis": {"$ref": "#/$defs/truthBasis"},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/taskId"}, "uniqueItems": true},
        "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "target_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target_symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "interfaces": {"type": "object"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["kind"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["process", "inspection"]}, "command": {"type": "string"}, "mechanism": {"type": "string"}, "proves": {"type": "array"}, "expected": {}}, "additionalProperties": true}},
        "evidence_capability": {"type": "object", "required": ["result", "reason", "invariants"], "additionalProperties": true},
        "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "methodology": {"type": "object", "minProperties": 1},
        "executor_profile": {"type": "object", "required": ["capability", "context_mode", "review_capability"], "additionalProperties": true},
        "acceptance_review": {"type": "object", "required": ["required"], "additionalProperties": true},
        "allocated_rules": {"type": "array"},
        "allocated_skills": {"type": "array"},
        "handoff_contract": {"const": "executor-result-v1"}
      },
      "additionalProperties": false
    },
    "current": {
      "type": "object",
      "required": ["artifact_type", "schema_version", "id", "plan_id", "phase_id", "name", "status", "order", "task_type", "date_created", "last_updated", "source_ids", "source_obligations", "truth_basis", "depends_on", "source_files", "target_files", "target_symbols", "interfaces", "steps", "validation", "evidence_capability", "completion_criteria", "methodology", "executor_profile", "acceptance_review", "allocated_rules", "allocated_skills", "handoff_contract"],
      "properties": {
        "artifact_type": {"const": "task"},
        "schema_version": {"const": 3},
        "id": {"$ref": "#/$defs/taskId"},
        "plan_id": {"type": "string", "pattern": "^plan-[a-z0-9][a-z0-9-]*$"},
        "phase_id": {"type": "string", "pattern": "^phase-[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "planned"},
        "order": {"type": "integer", "minimum": 1},
        "task_type": {"type": "string", "minLength": 1},
        "date_created": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "last_updated": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "source_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceId"}, "uniqueItems": true},
        "source_obligations": {"$ref": "#/$defs/sourceObligations"},
        "truth_basis": {"$ref": "#/$defs/truthBasis"},
        "depends_on": {"type": "array", "items": {"$ref": "#/$defs/taskId"}, "uniqueItems": true},
        "source_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "target_files": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "target_symbols": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "interfaces": {"$ref": "#/$defs/interfaces"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "array", "minItems": 1, "items": {"oneOf": [{"$ref": "#/$defs/processValidation"}, {"$ref": "#/$defs/inspectionValidation"}]}},
        "evidence_capability": {"type": "object", "required": ["result", "reason", "invariants"], "additionalProperties": true},
        "completion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "methodology": {"type": "object", "minProperties": 1},
        "executor_profile": {"type": "object", "required": ["capability", "context_mode", "review_capability"], "additionalProperties": true},
        "acceptance_review": {"type": "object", "required": ["required"], "additionalProperties": true},
        "allocated_rules": {"type": "array"},
        "allocated_skills": {"type": "array"},
        "handoff_contract": {"const": "executor-result-v2"}
      },
      "additionalProperties": false
    }
  }
}
